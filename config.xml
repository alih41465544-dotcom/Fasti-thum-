<?xml version='1.0' encoding='utf-8'?>
<widget id="com.fastithum.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Fasti Thum</name>
    <description>
        Fasti Thum — thumbnail & cover maker app
    </description>
    <author email="you@example.com" href="https://github.com/">Fasti Thum</author>

    <content src="index.html" />

    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="geo:*" />

    <preference name="DisallowOverscroll" value="true" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="AndroidXEnabled" value="true" />

    <platform name="android">
        <allow-intent href="market:*" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:requestLegacyExternalStorage="true" />
        </edit-config>
    </platform>

    <!-- জরুরি প্লাগিনগুলো — এগুলো ছাড়া গ্যালারিতে সেভ, শেয়ার, পারমিশন কিছুই কাজ করবে না -->
    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />
    <plugin name="cordova-plugin-file" spec="^7.0.0" />
    <plugin name="cordova-plugin-android-permissions" spec="^1.1.5" />
    <plugin name="cordova-plugin-x-socialsharing" spec="^6.0.3" />
    <plugin name="@tanyijia/cordova-save-image-gallery" spec="^0.1.4" />
</widget>
